# =============================================================
# BOOKING FRONTEND — Variables de entorno por cliente
# Copiar este archivo como .env y rellenar los valores.
# En Dokploy: pegar estas variables en "Build Arguments" del servicio frontend.
# =============================================================

# --- API ---
PUBLIC_API_URL=http://localhost:8000/api

# --- MARCA ---
PUBLIC_BRAND_NAME=Booking Caribe
PUBLIC_BRAND_TAGLINE=Tours, hoteles y traslados en el Caribe Mexicano
PUBLIC_SITE_URL=https://bookingcaribe.com
PUBLIC_LOGO_PATH=/logo.svg
PUBLIC_FAVICON_PATH=/favicon.svg

# --- COLORES (hex) ---
PUBLIC_COLOR_PRIMARY=#8B5CF6
PUBLIC_COLOR_SECONDARY=#F472B6
PUBLIC_COLOR_ACCENT=#FBBF24

# --- SERVICIOS (poner 'false' para desactivar) ---
PUBLIC_SERVICE_HOTELS=true
PUBLIC_SERVICE_TOURS=true
PUBLIC_SERVICE_TRANSFERS=true

# --- CONTACTO ---
PUBLIC_WHATSAPP=+52 998 123 4567
PUBLIC_PHONE=+52 998 123 4567
PUBLIC_EMAIL=reservas@bookingcaribe.com
PUBLIC_ADDRESS=Playa del Carmen, Quintana Roo, México

# --- REDES SOCIALES (dejar vacío para ocultar el ícono) ---
PUBLIC_SOCIAL_FACEBOOK=https://facebook.com/bookingcaribe
PUBLIC_SOCIAL_INSTAGRAM=https://instagram.com/bookingcaribe
PUBLIC_SOCIAL_TWITTER=

# --- UBICACIÓN / SEO ---
PUBLIC_LOCATION_NAME=Riviera Maya & Cancún
PUBLIC_LOCATION_REGION=Quintana Roo
PUBLIC_LOCATION_COUNTRY=México
PUBLIC_LOCATION_DESC=Destino turístico de clase mundial en el Caribe Mexicano
# Keywords separadas por coma, sin espacios después de la coma
PUBLIC_SEO_KEYWORDS=tours cancun,hoteles riviera maya,traslado aeropuerto cancun

# --- ANALYTICS (dejar vacío para desactivar) ---
PUBLIC_GA_ID=
PUBLIC_FB_PIXEL=
